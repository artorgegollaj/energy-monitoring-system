# Copy to .env and change the values: cp .env.example .env

# PostgreSQL
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=energy_db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# Kafka (host-side port for the external listener localhost:<port>)
KAFKA_EXTERNAL_PORT=9092
